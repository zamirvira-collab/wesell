
/* WE-SELL SAVED CARS NAVIGATION */

.ws-saved-nav {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: color 0.2s ease;
}

.ws-saved-nav:hover {
    color: #ffca36;
}

.ws-heart-icon {
    font-size: 23px;
    line-height: 1;
    color: #ffca36;
}

.ws-saved-count {
    background: #ffca36;
    color: #09243f;
    padding: 2px 7px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 800;
}

.ws-saved-count[hidden] {
    display: none;
}
