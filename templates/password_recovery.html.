
{% extends 'base.html' %}

{% block title %}
{{ 'Reset Password' if mode == 'reset' else 'Forgot Password' }} | WE-SELL
{% endblock %}

{% block content %}

<style>
.ws-recovery-page {
    min-height: 80vh;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 45px 18px;
    font-family: Arial, Helvetica, sans-serif;
}

.ws-recovery-card {
    width: 100%;
    max-width: 460px;
    padding: 42px 36px;
    background: white;
    border-radius: 20px;
    box-shadow: 0 18px 55px rgba(6, 29, 53, .12);
}

.ws-recovery-logo {
    color: #061d35;
    font-size: 30px;
    font-weight: 900;
    text-align: center;
    margin-bottom: 12px;
}

.ws-recovery-logo span {
    color: #d99c00;
}

.ws-recovery-title {
    color: #061d35;
    font-size: 26px;
    font-weight: 900;
    text-align: center;
    margin: 20px 0 10px;
}

.ws-recovery-description {
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 28px;
}

.ws-recovery-field {
    margin-bottom: 20px;
}

.ws-recovery-field label {
    display: block;
    font-size: 13px;
    font-weight: 800;
    color: #102b46;
    margin-bottom: 9px;
}

.ws-recovery-field input {
    box-sizing: border-box;
    width: 100%;
    padding: 14px;
    border: 1px solid #d7e1eb;
    border-radius: 10px;
    font-size: 15px;
}

.ws-recovery-field input:focus {
    outline: none;
    border-color: #08a99b;
    box-shadow: 0 0 0 3px rgba(8, 169, 155, .12);
}

.ws-recovery-button {
    width: 100%;
    min-height: 50px;
    border: none;
    border-radius: 10px;
    background: #ffc400;
    color: #061d35;
    font-size: 15px;
    font-weight: 900;
    cursor: pointer;
}

.ws-recovery-button:hover {
    background: #f2b700;
}

.ws-recovery-back {
    text-align: center;
    margin-top: 25px;
}

.ws-recovery-back a {
    color: #008b91;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
}

.ws-recovery-back a:hover {
    text-decoration: underline;
}

@media (max-width: 500px) {
    .ws-recovery-card {
        padding: 30px 22px;
    }
}
</style>

<section class="ws-recovery-page">
    <div class="ws-recovery-card">

        <div class="ws-recovery-logo">
            WE-<span>SELL</span>
        </div>

        {% if mode == 'reset' %}

            <h1 class="ws-recovery-title">
                Create New Password
            </h1>

            <p class="ws-recovery-description">
                Enter your new password below to regain
                access to your WE-SELL account.
            </p>

            <form method="POST">

                <input
                    type="hidden"
                    name="csrf"
                    value="{{ csrf }}">

                <div class="ws-recovery-field">
                    <label for="new-password">
                        New Password
                    </label>

                    <input
                        id="new-password"
                        type="password"
                        name="password"
                        minlength="10"
                        autocomplete="new-password"
                        required>
                </div>

                <div class="ws-recovery-field">
                    <label for="confirm-password">
                        Confirm New Password
                    </label>

                    <input
                        id="confirm-password"
                        type="password"
                        name="confirm_password"
                        minlength="10"
                        autocomplete="new-password"
                        required>
                </div>

                <button
                    type="submit"
                    class="ws-recovery-button">
                    Reset Password
                </button>

            </form>

        {% else %}

            <h1 class="ws-recovery-title">
                Forgot Your Password?
            </h1>

            <p class="ws-recovery-description">
                Enter your registered email address.
                If an account exists, we will send you
                instructions to reset your password.
            </p>

            <form method="POST">

                <input
                    type="hidden"
                    name="csrf"
                    value="{{ csrf }}">

                <div class="ws-recovery-field">
                    <label for="recovery-email">
                        Email Address
                    </label>

                    <input
                        id="recovery-email"
                        type="email"
                        name="email"
                        placeholder="Enter your registered email"
                        autocomplete="email"
                        maxlength="254"
                        required>
                </div>

                <button
                    type="submit"
                    class="ws-recovery-button">
                    Send Reset Link
                </button>

            </form>

        {% endif %}

        <div class="ws-recovery-back">
            <a href="{{ url_for('login') }}">
                ← Back to Dealer Login
            </a>
        </div>

    </div>
</section>

{% endblock %}
